# Environment Configuration
PROJECT_NAME="Zilqa E-Commerce API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zilqa
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_POOL_MAX_INACTIVE_CONNECTION_LIFETIME=300.0
DB_POOL_TIMEOUT=30.0

# Security & Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Google Authentication
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Cloudflare R2 Public Media URL (e.g. https://pub-xxxxxx.r2.dev or custom CDN domain)
R2_PUBLIC_URL=https://pub-your-r2-id.r2.dev

